# Copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# You get SENSOR_ID and TOKEN from JustDNS when you register your node
# (see the README). The token is write-only: it can only submit events,
# nothing else, and we can revoke it per node at any time.

# Your node name, as agreed with JustDNS (e.g. own-berlin-01).
SENSOR_ID=changeme

# The submission token you received. Keep it secret.
TOKEN=jdhs_changeme

# Where events go. Leave this as is unless told otherwise.
INTAKE_URL=https://intake.justdns.justfuture.at

# Host port for the SSH honeypot. Default 2222. Set to 22 only on a box
# where port 22 is free (then attackers reach the honeypot directly).
COWRIE_SSH_PORT=2222

# Seconds between shipper runs.
SHIPPER_INTERVAL=120
