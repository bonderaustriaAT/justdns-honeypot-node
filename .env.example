# Copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# You do NOT need a token to start. On its first run the shipper registers
# itself with the JustDNS intake and stores its own write-only token. Your
# node sends right away; its IPs only enter the public list once JustDNS has
# reviewed and approved your node (see the README).

# A friendly name for your node, shown to us in the dashboard. Optional.
# If left blank, your hostname is used.
SENSOR_ID=

# Optional label so we can reach you (team, email, handle). Shown to us only.
OPERATOR=

# Where events go. Leave this as is unless told otherwise.
INTAKE_URL=https://intake.justdns.justfuture.at

# Optional: a token you were handed directly by JustDNS. Leave BLANK for the
# normal self-register flow. Only set this for a pre-arranged node.
TOKEN=

# Host port for the SSH honeypot (Cowrie). Default 2222. Set to 22 only on a
# box where port 22 is free (then attackers reach the honeypot directly).
COWRIE_SSH_PORT=2222

# Host ports for the OpenCanary services. Defaults match the real service
# ports, so attackers hitting them land on the decoy. Change only if the port
# is already taken on your host; then forward the WAN port to the new one.
FTP_PORT=21
TELNET_PORT=23
OC_HTTP_PORT=80
MYSQL_PORT=3306
RDP_PORT=3389
VNC_PORT=5900

# Seconds between shipper runs.
SHIPPER_INTERVAL=120

# Local live view of attacks on this node (http://127.0.0.1:<port>). It is
# bound to localhost only, because it shows attacker credentials.
NODEUI_PORT=8080

# Optional Bearer token for the live view. Set this (and put a TLS reverse
# proxy in front) if you ever need to reach it from another machine.
NODEUI_TOKEN=
