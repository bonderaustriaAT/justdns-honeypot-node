[Unit]
Description=JustDNS node64-Reader (Policy-Blocks -> Intake-API, nur lesen)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=NODE64_CONFIG=/etc/justdns-node64.conf
ExecStart=/usr/bin/python3 /opt/justdns-firewall/node64_reader.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/justdns-firewall
