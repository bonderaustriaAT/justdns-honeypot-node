[Unit]
Description=JustDNS honeypot node self-update (git pull + docker compose)
Documentation=https://github.com/bonderaustriaAT/justdns-honeypot-node
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Path to your clone. Change this if you cloned the repo somewhere else.
WorkingDirectory=/opt/justdns-honeypot-node
ExecStart=/opt/justdns-honeypot-node/scripts/self-update.sh
# Do not let an update hang forever.
TimeoutStartSec=900
