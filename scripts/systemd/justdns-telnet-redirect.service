[Unit]
Description=JustDNS honeypot node Telnet-Redirect (WAN 23 -> cowrie-Telnet 2223) beim Boot setzen
Documentation=https://github.com/bonderaustriaAT/justdns-honeypot-node
After=network-online.target nftables.service justdns-egress.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/justdns-honeypot-node
# Ports anpassen, falls noetig:
#   Environment=TELNET_WAN_PORT=23
#   Environment=COWRIE_TELNET_PORT=2223
ExecStart=/opt/justdns-honeypot-node/scripts/telnet-redirect.sh
ExecStop=/opt/justdns-honeypot-node/scripts/telnet-redirect.sh --off
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
