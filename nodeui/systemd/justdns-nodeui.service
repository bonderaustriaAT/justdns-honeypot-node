[Unit]
Description=JustDNS honeypot node, live attack view
After=network.target

[Service]
Type=simple
# Reachable from the internal network. It shows attacker credentials: keep it on
# the internal network, do not forward it from the WAN. For remote access set
# NODEUI_TOKEN and put a TLS reverse proxy in front.
Environment=NODEUI_BIND=0.0.0.0
Environment=NODEUI_PORT=8080
Environment=COWRIE_LOG=/home/cowrie/cowrie/var/log/cowrie/cowrie.json*
Environment=OC_LOG=/var/tmp/opencanary.log*
# Optional: protect it with a token if you ever expose it.
# Environment=NODEUI_TOKEN=change-me
ExecStart=/usr/bin/python3 /opt/justdns-nodeui/nodeui.py
Restart=on-failure
RestartSec=5
User=cowrie
Group=cowrie
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
